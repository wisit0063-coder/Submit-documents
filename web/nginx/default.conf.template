# nginx for the CPRU publishing-fee SPA.
#
# Serves the Vite build and reverse-proxies /api to the API container, so the
# browser sees one origin: the httpOnly auth cookie travels without CORS.
#
# This file is a template: ${API_UPSTREAM} is filled in at container start.
# Only variables defined in the environment are substituted, so nginx
# variables such as $uri are left untouched.

# Docker embedded DNS. Re-resolve the API name so a restarted API container
# with a new IP is picked up without restarting nginx.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  server_tokens off;

  # 10 MB per attachment (CLAUDE.md section 3) plus multipart overhead.
  # The API enforces the exact limit and returns a proper error.
  client_max_body_size 11m;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass http://$api_upstream;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # The API trusts this header for the IP written to request_status_logs.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # PDF and Excel exports stream from the API; do not buffer them to disk.
    proxy_buffering off;
    proxy_read_timeout 120s;
  }

  # Hashed build assets never change under the same name.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # Everything else is a client-side route handled by React Router.
  location / {
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    try_files $uri $uri/ /index.html;
  }
}
