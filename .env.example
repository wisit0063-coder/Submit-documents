# Environment for docker compose.
#
# This file is optional: docker-compose.yml already defaults to these same TEST
# values, so `docker compose up` works without a .env file.
#
# For a real deployment, copy it and replace every value marked "test":
#   cp .env.example .env
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

COMPOSE_PROJECT_NAME=cpru-pubfee

# ---- Published ports ----
WEB_PORT=8080
# Development override only (docker-compose.dev.yml)
WEB_DEV_PORT=5173
API_PORT=3000
DB_PORT=5432

# ---- Database ----
# Two ways to run:
#
# A) Local Postgres container (default, used for development and e2e tests).
#    Leave DATABASE_URL and DIRECT_URL unset; the values below build the URL.
#    These passwords are placed inside DATABASE_URL: use letters and digits
#    only, or percent-encode characters such as @ : / ? #
POSTGRES_DB=cpru_pubfee
POSTGRES_USER=cpru
POSTGRES_PASSWORD=cpruTest2569

# B) Supabase (hosted Postgres). Set both URLs and the local db container is
#    ignored. Copy them from the Supabase dashboard:
#      Project Settings -> Database -> Connection string -> URI
#
#    DATABASE_URL  = Transaction pooler (port 6543) - used while the app runs.
#                    Prisma needs the two query parameters shown below.
#    DIRECT_URL    = Direct connection (port 5432) - used by migrations only,
#                    because DDL cannot run through the pooler.
#
#    Both strings contain the database password: never commit the real .env.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Application ----
# Public address users open in the browser; used for links inside emails.
APP_BASE_URL=http://localhost:8080

JWT_SECRET=test-jwt-secret-local-docker-only
JWT_EXPIRES_IN=8h
COOKIE_NAME=cpru_token
# Set to true as soon as the site is behind HTTPS. Keep false for http://localhost,
# otherwise the browser drops the login cookie.
COOKIE_SECURE=false

# Load roles, faculties, journal tiers, the 2569 budget year and demo accounts
# on start. Safe to leave on: reference data is upserted and demo accounts are
# only created while the users table is empty. Turn off for production.
RUN_SEED=true

# Download the Sarabun fonts while building the API image. Set to false for an
# offline build and place the TTF files in api/assets/fonts/ instead.
FETCH_FONTS=true

# ---- Email ----
# log = print notifications to the container log; smtp = send for real
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ระบบเบิกค่าตอบแทนการตีพิมพ์ <noreply@cpru.ac.th>"

# ---- Reminders ----
# Shared secret between the cron container and POST /api/cron/reminders
CRON_TOKEN=test-cron-token-local-docker-only
# Remind when a request has waited this many business days
REMINDER_AFTER_BUSINESS_DAYS=5
# crontab format, Bangkok time
REMINDER_SCHEDULE=0 8 * * *
