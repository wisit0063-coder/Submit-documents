// ARCHIVE - สำเนา schema ฉบับ MySQL ก่อนย้ายไป PostgreSQL/Supabase (23 ก.ย. 2569)
// ไฟล์นี้ไม่ได้ถูกใช้งาน ของจริงคือ api/prisma/schema.prisma - ห้ามคัดลอกไฟล์นี้ทับของจริง
// ระบบเบิกจ่ายค่าตอบแทนการตีพิมพ์บทความผลงานทางวิชาการ
// มหาวิทยาลัยราชภัฏชัยภูมิ - อ้างอิงประกาศเลขที่ 2131/2566 และแบบฟอร์ม CPRU-RDI-F011
// Prisma + MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// 1. FACULTIES - คณะ / หน่วยงาน
// ---------------------------------------------------------------
model Faculty {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  nameTh    String   @map("name_th") @db.VarChar(255)
  nameEn    String?  @map("name_en") @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  departments Department[]
  requests    Request[]

  @@map("faculties")
}

// ---------------------------------------------------------------
// 2. DEPARTMENTS - ภาควิชา / สาขาวิชา
// ---------------------------------------------------------------
model Department {
  id        BigInt   @id @default(autoincrement())
  facultyId BigInt   @map("faculty_id")
  code      String   @db.VarChar(20)
  nameTh    String   @map("name_th") @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faculty Faculty @relation(fields: [facultyId], references: [id])
  users   User[]

  @@unique([facultyId, code])
  @@index([facultyId])
  @@map("departments")
}

// ---------------------------------------------------------------
// 3. USERS - ผู้ใช้งาน (ทำตารางเอง ไม่ใช้ SSO)
// ฟิลด์ล้อกับช่องกรอกในแบบฟอร์ม CPRU-RDI-F011
// ---------------------------------------------------------------
model User {
  id                 BigInt    @id @default(autoincrement())
  username           String    @unique @db.VarChar(100)
  email              String    @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  prefix             String?   @db.VarChar(50)   // นาย / นาง / นางสาว / ดร.
  firstName          String    @map("first_name") @db.VarChar(150)
  lastName           String    @map("last_name") @db.VarChar(150)
  academicPosition   String?   @map("academic_position") @db.VarChar(150) // ตำแหน่งทางวิชาการ
  departmentId       BigInt?   @map("department_id")
  phoneInternal      String?   @map("phone_internal") @db.VarChar(20)
  phoneMobile        String?   @map("phone_mobile") @db.VarChar(20)
  lineUserId         String?   @map("line_user_id") @db.VarChar(100)
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  department      Department?         @relation(fields: [departmentId], references: [id])
  userRoles       UserRole[]
  requests        Request[]           @relation("RequestOwner")
  approvals       RequestApproval[]
  statusLogs      RequestStatusLog[]
  uploadedFiles   RequestAttachment[] @relation("AttachmentUploader")
  verifiedFiles   RequestAttachment[] @relation("AttachmentVerifier")
  recordedPayment Payment[]

  @@index([departmentId])
  @@map("users")
}

// ---------------------------------------------------------------
// 4. ROLES - บทบาท
// RESEARCHER / FACULTY_QA / DEAN / RDI_OFFICER / ACADEMIC_OFFICE / APPROVER / FINANCE / ADMIN
// ---------------------------------------------------------------
model Role {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("roles")
}

// ---------------------------------------------------------------
// 5. USER_ROLES - many-to-many
// คนเดียวถือได้หลายบทบาท เช่น คณบดีที่ยื่นขอเบิกของตัวเองด้วย
// ---------------------------------------------------------------
model UserRole {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  roleId    BigInt   @map("role_id")
  facultyId BigInt?  @map("faculty_id") // ขอบเขตบทบาท เช่น คณบดีของคณะไหน
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, facultyId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------
// 6. JOURNAL_TIERS - อัตราค่าตอบแทนตามประเภทวารสาร
// เก็บเป็นข้อมูล ไม่ hard-code เพราะประกาศเปลี่ยนได้ (เช่น ACI ปิดฐานข้อมูลแล้ว)
// ---------------------------------------------------------------
model JournalTier {
  id              BigInt    @id @default(autoincrement())
  code            String    @unique @db.VarChar(50) // SCOPUS_Q1, WOS_ISI, TCI_1 ...
  nameTh          String    @map("name_th") @db.VarChar(255)
  databaseName    String    @map("database_name") @db.VarChar(100)
  quartile        String?   @db.VarChar(5)
  rateNormal      Decimal   @map("rate_normal") @db.Decimal(12, 2)
  rateConference  Decimal   @map("rate_conference") @db.Decimal(12, 2)
  announcementRef String?   @map("announcement_ref") @db.VarChar(100)
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  sortOrder       Int       @default(0) @map("sort_order")

  requests Request[]

  @@map("journal_tiers")
}

// ---------------------------------------------------------------
// 7. BUDGET_YEARS - วงเงินกองทุนวิจัยรายปีงบประมาณ
// ---------------------------------------------------------------
model BudgetYear {
  id          BigInt   @id @default(autoincrement())
  year        Int      @unique // ปีงบประมาณ พ.ศ.
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  isActive    Boolean  @default(false) @map("is_active")
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  requests Request[]
  payments Payment[]

  @@map("budget_years")
}

// ---------------------------------------------------------------
// 8. REQUESTS - คำขอรับค่าตอบแทน (ตารางหลัก)
// ---------------------------------------------------------------
model Request {
  id        BigInt @id @default(autoincrement())
  requestNo String @unique @map("request_no") @db.VarChar(30) // RQ-2569-0001

  userId       BigInt @map("user_id")
  facultyId    BigInt @map("faculty_id")    // snapshot ตอนยื่น
  departmentId BigInt @map("department_id")

  // ข้อมูลบทความ
  articleTitle String    @map("article_title") @db.Text
  journalName  String    @map("journal_name") @db.VarChar(500)
  volume       String?   @db.VarChar(50)
  issue        String?   @db.VarChar(50)
  pages        String?   @db.VarChar(50)
  issn         String?   @db.VarChar(20)
  doi          String?   @db.VarChar(255)
  articleUrl   String?   @map("article_url") @db.Text
  publishedAt  DateTime  @map("published_at") @db.Date

  // การคำนวณเงิน
  journalTierId    BigInt  @map("journal_tier_id")
  fromConference   Boolean @default(false) @map("from_conference")
  amountRequested  Decimal @map("amount_requested") @db.Decimal(12, 2)
  amountApproved   Decimal? @map("amount_approved") @db.Decimal(12, 2)

  // การนับสิทธิ์ตามประกาศ (ไม่เกิน 3 เรื่องต่อปีปฏิทิน)
  calendarYear   Int  @map("calendar_year")
  sequenceInYear Int? @map("sequence_in_year")

  budgetYearId    BigInt  @map("budget_year_id")
  qaIndicatorYear Int?    @map("qa_indicator_year")

  // คำรับรอง 3 ข้อจากแบบฟอร์ม
  certNotOnStudyLeave Boolean @default(false) @map("cert_not_on_study_leave")
  certNotThesisPart   Boolean @default(false) @map("cert_not_thesis_part")
  certNotDuplicate    Boolean @default(false) @map("cert_not_duplicate")

  status      RequestStatus @default(DRAFT)
  currentStep Int           @default(0) @map("current_step")

  submittedAt DateTime? @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner       User                @relation("RequestOwner", fields: [userId], references: [id])
  faculty     Faculty             @relation(fields: [facultyId], references: [id])
  journalTier JournalTier         @relation(fields: [journalTierId], references: [id])
  budgetYear  BudgetYear          @relation(fields: [budgetYearId], references: [id])
  attachments RequestAttachment[]
  approvals   RequestApproval[]
  statusLogs  RequestStatusLog[]
  payment     Payment?

  @@index([userId, calendarYear])
  @@index([status])
  @@index([doi])
  @@index([budgetYearId])
  @@map("requests")
}

enum RequestStatus {
  DRAFT                    // ร่าง
  FACULTY_REVIEW           // รอคณะตรวจสอบ
  DEAN_REVIEW              // รอคณบดีเห็นชอบ
  RDI_REVIEW               // รอสถาบันวิจัยตรวจสอบ
  RETURNED                 // ตีกลับให้ผู้ขอแก้ไข
  ACADEMIC_OFFICE_REVIEW   // รอสำนักส่งเสริมวิชาการ
  COMMITTEE_REVIEW         // รอคณะกรรมการบริหารจัดการงานวิจัย
  PENDING_APPROVAL         // รออนุมัติ
  APPROVED                 // อนุมัติแล้ว (จองงบ)
  REJECTED                 // ไม่อนุมัติ
  PAID                     // จ่ายแล้ว
  CANCELLED                // ยกเลิกโดยผู้ขอ
  REFUNDED                 // เรียกเงินคืน
}

// ---------------------------------------------------------------
// 9. REQUEST_ATTACHMENTS - ไฟล์แนบ (เก็บนอก public_html)
// ---------------------------------------------------------------
model RequestAttachment {
  id         BigInt   @id @default(autoincrement())
  requestId  BigInt   @map("request_id")
  docType    DocType  @map("doc_type")
  fileName   String   @map("file_name") @db.VarChar(255)
  storedPath String   @map("stored_path") @db.VarChar(500)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  fileSize   Int      @map("file_size")
  uploadedBy BigInt   @map("uploaded_by")
  isVerified Boolean  @default(false) @map("is_verified")
  verifiedBy BigInt?  @map("verified_by")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime @default(now()) @map("created_at")

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader User    @relation("AttachmentUploader", fields: [uploadedBy], references: [id])
  verifier User?   @relation("AttachmentVerifier", fields: [verifiedBy], references: [id])

  @@index([requestId])
  @@map("request_attachments")
}

enum DocType {
  ACCEPTANCE_LETTER  // หนังสือตอบรับการตีพิมพ์
  ARTICLE_COPY       // สำเนาบทความฉบับเต็ม
  DATABASE_PROOF     // หลักฐานแสดงฐานข้อมูลวารสาร
  ADDITIONAL         // เอกสารเพิ่มเติมตามที่ถูกตีกลับ
}

// ---------------------------------------------------------------
// 10. REQUEST_APPROVALS - ผลการพิจารณาแต่ละขั้น (แทนลายเซ็นบนกระดาษ)
// ---------------------------------------------------------------
model RequestApproval {
  id               BigInt           @id @default(autoincrement())
  requestId        BigInt           @map("request_id")
  stepOrder        Int              @map("step_order")
  stepCode         ApprovalStepCode @map("step_code")
  approverId       BigInt?          @map("approver_id")
  decision         ApprovalDecision @default(PENDING)
  comment          String?          @db.Text
  missingDocuments String?          @map("missing_documents") @db.Text
  amountApproved   Decimal?         @map("amount_approved") @db.Decimal(12, 2)
  signedAt         DateTime?        @map("signed_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User?   @relation(fields: [approverId], references: [id])

  @@unique([requestId, stepOrder])
  @@index([approverId, decision])
  @@map("request_approvals")
}

enum ApprovalStepCode {
  FACULTY_QA       // เจ้าหน้าที่ประกันคุณภาพระดับคณะ
  DEAN             // คณบดี
  RDI              // สถาบันวิจัยและพัฒนา
  ACADEMIC_OFFICE  // สำนักส่งเสริมวิชาการฯ
  COMMITTEE        // คณะกรรมการบริหารจัดการงานวิจัย
  APPROVER         // รองอธิการบดีฝ่ายวิจัยฯ
}

enum ApprovalDecision {
  PENDING
  APPROVED
  RETURNED
  REJECTED
}

// ---------------------------------------------------------------
// 11. REQUEST_STATUS_LOGS - timeline ให้ผู้ขอติดตาม + audit trail
// ---------------------------------------------------------------
model RequestStatusLog {
  id         BigInt         @id @default(autoincrement())
  requestId  BigInt         @map("request_id")
  fromStatus RequestStatus? @map("from_status")
  toStatus   RequestStatus  @map("to_status")
  actorId    BigInt?        @map("actor_id")
  note       String?        @db.Text
  ipAddress  String?        @map("ip_address") @db.VarChar(45)
  createdAt  DateTime       @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([requestId, createdAt])
  @@map("request_status_logs")
}

// ---------------------------------------------------------------
// 12. PAYMENTS - การเบิกจ่ายจริงและการตัดงบ
// ---------------------------------------------------------------
model Payment {
  id           BigInt    @id @default(autoincrement())
  requestId    BigInt    @unique @map("request_id")
  budgetYearId BigInt    @map("budget_year_id")
  voucherNo    String?   @map("voucher_no") @db.VarChar(50)
  amount       Decimal   @db.Decimal(12, 2)
  paidAt       DateTime? @map("paid_at")
  recordedBy   BigInt    @map("recorded_by")
  isRefunded   Boolean   @default(false) @map("is_refunded")
  refundAmount Decimal?  @map("refund_amount") @db.Decimal(12, 2)
  refundReason String?   @map("refund_reason") @db.Text
  refundedAt   DateTime? @map("refunded_at")
  note         String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  request    Request    @relation(fields: [requestId], references: [id])
  budgetYear BudgetYear @relation(fields: [budgetYearId], references: [id])
  recorder   User       @relation(fields: [recordedBy], references: [id])

  @@index([budgetYearId])
  @@map("payments")
}
