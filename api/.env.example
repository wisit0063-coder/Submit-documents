# ---- Database ----
# Pooled connection used at runtime (Supabase: port 6543 with pgbouncer=true).
DATABASE_URL="postgresql://cpru:password@localhost:5432/cpru_pubfee"
# Direct connection used by "prisma migrate" (Supabase: port 5432).
# On a plain Postgres server this is the same URL as above.
DIRECT_URL="postgresql://cpru:password@localhost:5432/cpru_pubfee"

# ---- Runtime ----
NODE_ENV=production
# Passenger assigns PORT. Never hard-code a port.
PORT=3000
TZ=Asia/Bangkok
APP_BASE_URL=https://research.cpru.ac.th
API_BASE_PATH=/api

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_NAME=cpru_token
COOKIE_SECURE=true

# ---- Uploads (must live outside public_html) ----
UPLOAD_DIR=/home/user/storage/uploads
MAX_UPLOAD_MB=10

# ---- SMTP ----
SMTP_HOST=smtp.cpru.ac.th
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@cpru.ac.th
SMTP_PASS=
MAIL_FROM="ระบบเบิกค่าตอบแทนการตีพิมพ์ <noreply@cpru.ac.th>"

# --- Web Push: popup notifications (CLAUDE.md ข้อ 10) ---
# Generate once with:  npx web-push generate-vapid-keys
# The private key signs every push - treat it like JWT_SECRET and never commit it.
# Left empty, popups are simply not sent; nothing else depends on them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@cpru.ac.th
# ปิดการส่งเมลจริง (ขึ้น log แทน) ใช้ตอน dev
MAIL_DRIVER=smtp

# ---- Cron (cPanel cron -> POST /api/cron/reminders) ----
CRON_TOKEN=change-me-too
REMINDER_AFTER_BUSINESS_DAYS=5
