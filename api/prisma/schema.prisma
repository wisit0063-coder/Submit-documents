// ระบบเบิกจ่ายค่าตอบแทนการตีพิมพ์บทความผลงานทางวิชาการ
// มหาวิทยาลัยราชภัฏชัยภูมิ - อ้างอิงประกาศเลขที่ 2131/2566 และแบบฟอร์ม CPRU-RDI-F011
// Prisma + PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase hands out two connection strings. DATABASE_URL is the pooled one
  // (pgbouncer, port 6543) used at runtime; DIRECT_URL is the direct one
  // (port 5432) that migrations need, because the pooler cannot hold the
  // session a DDL transaction requires. On plain Postgres both point at the
  // same server - see .env.example.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------
// 1. FACULTIES - คณะ / หน่วยงาน
// ---------------------------------------------------------------
model Faculty {
  id       BigInt @id @default(autoincrement())
  code     String @unique @db.VarChar(20)
  nameTh   String @map("name_th") @db.VarChar(255)
  nameEn   String? @map("name_en") @db.VarChar(255)
  /// Order the unit appears in every dropdown and report. Set by the owner, not
  /// alphabetical: sorting by name or code put the offices above the faculties
  /// in an order nobody asked for. Ties fall back to code.
  sortOrder Int      @default(100) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  departments Department[]
  requests    Request[]
  users       User[]

  @@map("faculties")
}

// ---------------------------------------------------------------
// 2. DEPARTMENTS - ภาควิชา / สาขาวิชา
// ---------------------------------------------------------------
model Department {
  id        BigInt   @id @default(autoincrement())
  facultyId BigInt   @map("faculty_id")
  code      String   @db.VarChar(20)
  nameTh    String   @map("name_th") @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faculty Faculty @relation(fields: [facultyId], references: [id])
  users   User[]

  @@unique([facultyId, code])
  @@index([facultyId])
  @@map("departments")
}

// ---------------------------------------------------------------
// 3. USERS - ผู้ใช้งาน (ทำตารางเอง ไม่ใช้ SSO)
// ฟิลด์ล้อกับช่องกรอกในแบบฟอร์ม CPRU-RDI-F011
// ---------------------------------------------------------------
model User {
  id                 BigInt    @id @default(autoincrement())
  username           String    @unique @db.VarChar(100)
  email              String    @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  /// Sessions signed before this moment are refused, so handing a position
  /// account on ends the previous holder sessions at once rather than leaving
  /// them valid until the token expires (utils/session.ts). Null while an
  /// account password has not changed since the column existed.
  passwordChangedAt  DateTime? @map("password_changed_at")
  prefix             String?   @db.VarChar(50) // นาย / นาง / นางสาว / ดร.
  firstName          String    @map("first_name") @db.VarChar(150)
  lastName           String    @map("last_name") @db.VarChar(150)
  academicPosition   String?   @map("academic_position") @db.VarChar(150) // ตำแหน่งทางวิชาการ
  departmentId       BigInt?   @map("department_id")
  phoneInternal      String?   @map("phone_internal") @db.VarChar(20)
  phoneMobile        String?   @map("phone_mobile") @db.VarChar(20)
  lineUserId         String?   @map("line_user_id") @db.VarChar(100)
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // หน่วยงาน/สังกัด เก็บตรงที่ user เพราะสาขาวิชาไม่บังคับกรอกตอนสมัคร (CLAUDE.md ข้อ 13.6)
  facultyId  BigInt?     @map("faculty_id")
  staffTrack StaffTrack? @map("staff_track") // สายงาน/ฝ่าย

  // สาขาวิชาที่ผู้สมัครพิมพ์เองตอนสมัคร เป็นข้อความอิสระ ไม่ผูกกับตาราง departments
  // ใช้ให้ ADMIN อ่านประกอบการอนุมัติ แล้วค่อยผูก department_id ที่ถูกต้องให้ภายหลัง
  departmentName String? @map("department_name") @db.VarChar(255)

  // สมัครเอง (ข้อ 13.4) - NULL หมายถึงบัญชีที่ ADMIN สร้างเอง ไม่ผ่านการสมัคร
  registrationStatus     RegistrationStatus? @map("registration_status")
  registrationReviewedBy BigInt?             @map("registration_reviewed_by")
  registrationReviewedAt DateTime?           @map("registration_reviewed_at")
  registrationNote       String?             @map("registration_note") @db.Text // เหตุผลที่ปฏิเสธ

  department            Department?         @relation(fields: [departmentId], references: [id])
  faculty               Faculty?            @relation(fields: [facultyId], references: [id])
  registrationReviewer  User?               @relation("RegistrationReviewer", fields: [registrationReviewedBy], references: [id])
  reviewedRegistrations User[]              @relation("RegistrationReviewer")
  userRoles             UserRole[]
  requests              Request[]           @relation("RequestOwner")
  approvals             RequestApproval[]
  statusLogs            RequestStatusLog[]
  uploadedFiles         RequestAttachment[] @relation("AttachmentUploader")
  verifiedFiles         RequestAttachment[] @relation("AttachmentVerifier")
  recordedPayment       Payment[]
  budgetYearLogs        BudgetYearLog[]
  positionHandovers     PositionHandoverLog[] @relation("PositionAccount")
  handoversPerformed    PositionHandoverLog[] @relation("PositionHandoverActor")
  pushSubscriptions     PushSubscription[]

  @@index([departmentId])
  @@index([facultyId])
  @@index([registrationStatus])
  @@map("users")
}

enum StaffTrack {
  ACADEMIC // ฝ่ายวิชาการ
  SUPPORT // ฝ่ายสนับสนุน
}

enum RegistrationStatus {
  PENDING // รอ ADMIN ตรวจสอบ
  APPROVED // อนุมัติแล้ว เข้าใช้งานได้
  REJECTED // ไม่อนุมัติ
}

// ---------------------------------------------------------------
// 4. ROLES - บทบาท
// RESEARCHER / FACULTY_QA / DEAN / RDI_OFFICER / ACADEMIC_OFFICE / APPROVER / FINANCE / ADMIN
// ---------------------------------------------------------------
model Role {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("roles")
}

// ---------------------------------------------------------------
// 5. USER_ROLES - many-to-many
// คนเดียวถือได้หลายบทบาท เช่น คณบดีที่ยื่นขอเบิกของตัวเองด้วย
// ---------------------------------------------------------------
model UserRole {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  roleId    BigInt   @map("role_id")
  facultyId BigInt?  @map("faculty_id") // ขอบเขตบทบาท เช่น คณบดีของคณะไหน
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, facultyId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------
// 6. JOURNAL_TIERS - อัตราค่าตอบแทนตามประเภทวารสาร
// เก็บเป็นข้อมูล ไม่ hard-code เพราะประกาศเปลี่ยนได้ (เช่น ACI ปิดฐานข้อมูลแล้ว)
// ---------------------------------------------------------------
model JournalTier {
  id              BigInt    @id @default(autoincrement())
  code            String    @unique @db.VarChar(50) // SCOPUS_Q1, WOS_ISI, TCI_1 ...
  nameTh          String    @map("name_th") @db.VarChar(255)
  databaseName    String    @map("database_name") @db.VarChar(100)
  quartile        String?   @db.VarChar(5)
  rateNormal      Decimal   @map("rate_normal") @db.Decimal(12, 2)
  rateConference  Decimal   @map("rate_conference") @db.Decimal(12, 2)
  announcementRef String?   @map("announcement_ref") @db.VarChar(100)
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  sortOrder       Int       @default(0) @map("sort_order")

  requests Request[]

  @@map("journal_tiers")
}

// ---------------------------------------------------------------
// 7. BUDGET_YEARS - วงเงินกองทุนวิจัยรายปีงบประมาณ
// ---------------------------------------------------------------
model BudgetYear {
  id          BigInt   @id @default(autoincrement())
  year        Int      @unique // ปีงบประมาณ พ.ศ.
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  isActive    Boolean  @default(false) @map("is_active")
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requests Request[]
  payments Payment[]
  logs     BudgetYearLog[]

  @@map("budget_years")
}

/// Every change to a fund ceiling, with the figure it replaced.
///
/// The ceiling is the one money value a person types in, and it used to be
/// editable with no trace at all: budget_years carried only created_at, so
/// nobody could say who raised a figure, when, or what it had been. Claims
/// have request_status_logs standing in for signatures on paper; the fund the
/// claims draw from had nothing.
model BudgetYearLog {
  id           BigInt           @id @default(autoincrement())
  budgetYearId BigInt           @map("budget_year_id")
  action       BudgetYearAction
  actorId      BigInt?          @map("actor_id")
  /// The name as it stood at the time. Accounts get renamed and position
  /// accounts get handed to the next holder, and neither may rewrite who set a
  /// figure years earlier (section 19.1).
  actorName    String           @map("actor_name") @db.VarChar(255)
  /// Null on CREATE: there was no previous figure.
  previousAmount   Decimal? @map("previous_amount") @db.Decimal(14, 2)
  newAmount        Decimal? @map("new_amount") @db.Decimal(14, 2)
  previousIsActive Boolean? @map("previous_is_active")
  newIsActive      Boolean? @map("new_is_active")
  reason       String?          @db.Text
  ipAddress    String?          @map("ip_address") @db.VarChar(45)
  createdAt    DateTime         @default(now()) @map("created_at")

  budgetYear BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorId], references: [id])

  @@index([budgetYearId, createdAt])
  @@map("budget_year_logs")
}

enum BudgetYearAction {
  CREATE
  UPDATE
}

// ---------------------------------------------------------------
// 8. REQUESTS - คำขอรับค่าตอบแทน (ตารางหลัก)
// ---------------------------------------------------------------
model Request {
  id        BigInt @id @default(autoincrement())
  requestNo String @unique @map("request_no") @db.VarChar(30) // RQ-2569-0001

  userId       BigInt @map("user_id")
  facultyId    BigInt @map("faculty_id") // snapshot ตอนยื่น
  departmentId BigInt @map("department_id")
  /// Subject area as the requester's own profile spells it, snapshotted when
  /// the request is filed. The form stopped asking for it (sign-up already
  /// collects it) and `departments` still holds only the placeholder row per
  /// unit until Q5 lands - without this the memo would print that placeholder
  /// instead of what the person actually wrote.
  departmentName String? @map("department_name") @db.VarChar(255)

  // ข้อมูลบทความ
  articleTitle String   @map("article_title") @db.Text
  journalName  String   @map("journal_name") @db.VarChar(500)
  volume       String?  @db.VarChar(50)
  issue        String?  @db.VarChar(50)
  pages        String?  @db.VarChar(50)
  issn         String?  @db.VarChar(20) // pISSN - ฉบับพิมพ์
  /// e-ISSN. The receipt voucher (ใบสำคัญรับเงิน) prints both numbers when a
  /// journal has both, so one column cannot hold what that form asks for.
  issnElectronic String? @map("issn_electronic") @db.VarChar(20)
  /// The coverage the journal prints on its own cover, e.g.
  /// "พฤษภาคม-สิงหาคม 2569". Most TCI journals publish per half-year, and the
  /// voucher quotes that range beside the volume and issue. Display only - the
  /// December grace period is still decided from published_at (CLAUDE.md 6).
  issuePeriod    String? @map("issue_period") @db.VarChar(120)
  doi          String?  @db.VarChar(255)
  articleUrl   String?  @map("article_url") @db.Text
  publishedAt  DateTime @map("published_at") @db.Date

  // การคำนวณเงิน
  journalTierId   BigInt   @map("journal_tier_id")
  fromConference  Boolean  @default(false) @map("from_conference")
  amountRequested Decimal  @map("amount_requested") @db.Decimal(12, 2)
  amountApproved  Decimal? @map("amount_approved") @db.Decimal(12, 2)

  // การนับสิทธิ์ตามประกาศ (ไม่เกิน 3 เรื่องต่อปีปฏิทิน)
  //
  // calendarYear   = ปีปฏิทินที่บทความ "ตีพิมพ์" (มาจาก published_at) ใช้ในรายงาน
  // entitlementYear = ปีปฏิทินที่ "ยื่น" ซึ่งเป็นปีที่ถูกหักสิทธิ์จริง เขียนตอนกดยื่น
  //                   เป็น NULL ตอนเป็นฉบับร่าง เพราะยังไม่ได้ยื่นจึงยังไม่กินสิทธิ์ใคร
  //
  // สองค่านี้ต่างกันเฉพาะในช่วงผ่อนผันเดือนมกราคม (isWithinClaimWindow ใน workflow.ts)
  // ห้ามรวมเป็นค่าเดียว บทความที่ตีพิมพ์ ธ.ค. แล้วยื่น ม.ค. กินสิทธิ์ของปีที่ยื่น
  calendarYear    Int  @map("calendar_year")
  entitlementYear Int? @map("entitlement_year")
  sequenceInYear  Int? @map("sequence_in_year")

  budgetYearId    BigInt @map("budget_year_id")
  qaIndicatorYear Int?   @map("qa_indicator_year")

  // คำรับรอง 3 ข้อจากแบบฟอร์ม
  certNotOnStudyLeave Boolean @default(false) @map("cert_not_on_study_leave")
  certNotThesisPart   Boolean @default(false) @map("cert_not_thesis_part")
  certNotDuplicate    Boolean @default(false) @map("cert_not_duplicate")

  status      RequestStatus @default(DRAFT)
  currentStep Int           @default(0) @map("current_step")

  submittedAt DateTime? @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner       User                @relation("RequestOwner", fields: [userId], references: [id])
  faculty     Faculty             @relation(fields: [facultyId], references: [id])
  journalTier JournalTier         @relation(fields: [journalTierId], references: [id])
  budgetYear  BudgetYear          @relation(fields: [budgetYearId], references: [id])
  attachments RequestAttachment[]
  approvals   RequestApproval[]
  statusLogs  RequestStatusLog[]
  payment     Payment?

  @@index([userId, calendarYear])
  @@index([userId, entitlementYear])
  @@index([status])
  @@index([doi])
  @@index([budgetYearId])
  @@map("requests")
}

enum RequestStatus {
  DRAFT // ร่าง
  FACULTY_REVIEW // รอคณะตรวจสอบ
  DEAN_REVIEW // รอคณบดีเห็นชอบ
  RDI_REVIEW // รอสถาบันวิจัยตรวจสอบ
  RETURNED // ตีกลับให้ผู้ขอแก้ไข
  ACADEMIC_OFFICE_REVIEW // รอสำนักส่งเสริมวิชาการ
  COMMITTEE_REVIEW // รอคณะกรรมการบริหารจัดการงานวิจัย
  PENDING_APPROVAL // รออนุมัติ
  APPROVED // อนุมัติแล้ว (จองงบ)
  REJECTED // ไม่อนุมัติ
  PAID // จ่ายแล้ว
  CANCELLED // ยกเลิกโดยผู้ขอ
  REFUNDED // เรียกเงินคืน
  REVOKED // ยกเลิกหลังอนุมัติ โดยงานวิจัย: คืนงบ คืนสิทธิ์ แต่บทความยังห้ามยื่นซ้ำ
}

// ---------------------------------------------------------------
// 9. REQUEST_ATTACHMENTS - ไฟล์แนบ (เก็บนอก public_html)
// ---------------------------------------------------------------
model RequestAttachment {
  id         BigInt    @id @default(autoincrement())
  requestId  BigInt    @map("request_id")
  docType    DocType   @map("doc_type")
  fileName   String    @map("file_name") @db.VarChar(255)
  storedPath String    @map("stored_path") @db.VarChar(500)
  mimeType   String    @map("mime_type") @db.VarChar(100)
  fileSize   Int       @map("file_size")
  uploadedBy BigInt    @map("uploaded_by")
  isVerified Boolean   @default(false) @map("is_verified")
  verifiedBy BigInt?   @map("verified_by")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader User    @relation("AttachmentUploader", fields: [uploadedBy], references: [id])
  verifier User?   @relation("AttachmentVerifier", fields: [verifiedBy], references: [id])

  @@index([requestId])
  @@map("request_attachments")
}

enum DocType {
  ACCEPTANCE_LETTER // หนังสือตอบรับการตีพิมพ์
  ARTICLE_COPY // สำเนาบทความฉบับเต็ม
  DATABASE_PROOF // หลักฐานแสดงฐานข้อมูลวารสาร
  ADDITIONAL // เอกสารเพิ่มเติมตามที่ถูกตีกลับ
}

// ---------------------------------------------------------------
// 10. REQUEST_APPROVALS - ผลการพิจารณาแต่ละขั้น (แทนลายเซ็นบนกระดาษ)
// ---------------------------------------------------------------
model RequestApproval {
  id               BigInt           @id @default(autoincrement())
  requestId        BigInt           @map("request_id")
  stepOrder        Int              @map("step_order")
  stepCode         ApprovalStepCode @map("step_code")
  approverId       BigInt?          @map("approver_id")
  /// The signer's name and position as they stood when the step was signed.
  /// Accounts get renamed and position accounts get handed to the next holder,
  /// and neither may rewrite who signed a memo years earlier (section 19.1).
  /// Null while the row is still PENDING, and on rows written before the
  /// snapshot existed.
  approverName     String?          @map("approver_name") @db.VarChar(255)
  approverPosition String?          @map("approver_position") @db.VarChar(150)
  decision         ApprovalDecision @default(PENDING)
  comment          String?          @db.Text
  missingDocuments String?          @map("missing_documents") @db.Text
  amountApproved   Decimal?         @map("amount_approved") @db.Decimal(12, 2)
  signedAt         DateTime?        @map("signed_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User?   @relation(fields: [approverId], references: [id])

  @@unique([requestId, stepOrder])
  @@index([approverId, decision])
  @@map("request_approvals")
}

enum ApprovalStepCode {
  FACULTY_QA // เจ้าหน้าที่ประกันคุณภาพระดับคณะ
  DEAN // คณบดี
  RDI // สถาบันวิจัยและพัฒนา
  ACADEMIC_OFFICE // สำนักส่งเสริมวิชาการฯ
  COMMITTEE // คณะกรรมการบริหารจัดการงานวิจัย
  APPROVER // รองอธิการบดีฝ่ายวิจัยฯ
}

enum ApprovalDecision {
  PENDING
  APPROVED
  RETURNED
  REJECTED
}

// ---------------------------------------------------------------
// 11. REQUEST_STATUS_LOGS - timeline ให้ผู้ขอติดตาม + audit trail
// ---------------------------------------------------------------
model RequestStatusLog {
  id         BigInt         @id @default(autoincrement())
  requestId  BigInt         @map("request_id")
  fromStatus RequestStatus? @map("from_status")
  toStatus   RequestStatus  @map("to_status")
  actorId    BigInt?        @map("actor_id")
  /// Who acted, as the log has to remember them (section 19.1). Null only on
  /// rows written before the snapshot existed, or when no account acted.
  actorName  String?        @map("actor_name") @db.VarChar(255)
  note       String?        @db.Text
  ipAddress  String?        @map("ip_address") @db.VarChar(45)
  createdAt  DateTime       @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([requestId, createdAt])
  @@map("request_status_logs")
}

// ---------------------------------------------------------------
// 12. PAYMENTS - การเบิกจ่ายจริงและการตัดงบ
// ---------------------------------------------------------------
model Payment {
  id           BigInt    @id @default(autoincrement())
  requestId    BigInt    @unique @map("request_id")
  budgetYearId BigInt    @map("budget_year_id")
  voucherNo    String?   @map("voucher_no") @db.VarChar(50)
  amount       Decimal   @db.Decimal(12, 2)
  paidAt       DateTime? @map("paid_at")
  recordedBy   BigInt    @map("recorded_by")
  /// Who recorded the payment, as it stood at the time (section 19.1).
  recordedByName String? @map("recorded_by_name") @db.VarChar(255)
  isRefunded   Boolean   @default(false) @map("is_refunded")
  refundAmount Decimal?  @map("refund_amount") @db.Decimal(12, 2)
  refundReason String?   @map("refund_reason") @db.Text
  refundedAt   DateTime? @map("refunded_at")
  note         String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  request    Request    @relation(fields: [requestId], references: [id])
  budgetYear BudgetYear @relation(fields: [budgetYearId], references: [id])
  recorder   User       @relation(fields: [recordedBy], references: [id])

  @@index([budgetYearId])
  @@map("payments")
}

/// ประวัติการส่งมอบบัญชีประจำตำแหน่ง (CLAUDE.md ข้อ 19)
///
/// Evidence on the same footing as RequestStatusLog and BudgetYearLog: written
/// in the same transaction as the change, and with no route that deletes a row.
/// A password stands in for a signature here, so being able to answer who was
/// given the ability to sign for a post, by whom and why, matters as much as
/// the signatures themselves.
model PositionHandoverLog {
  id       BigInt                @id @default(autoincrement())
  userId   BigInt                @map("user_id")
  action   PositionAccountAction
  actorId  BigInt?               @map("actor_id")
  /// Names as they stood at the time, never joined live - this table exists
  /// because the account's own name is about to be overwritten.
  actorName        String  @map("actor_name") @db.VarChar(255)
  previousHolder   String  @map("previous_holder") @db.VarChar(255)
  newHolder        String  @map("new_holder") @db.VarChar(255)
  previousPosition String? @map("previous_position") @db.VarChar(150)
  newPosition      String? @map("new_position") @db.VarChar(150)
  /// Which steps the account could sign for at the time, as plain text, so the
  /// row still reads correctly after its roles change.
  rolesSnapshot String   @map("roles_snapshot") @db.Text
  reason        String   @db.Text
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  createdAt     DateTime @default(now()) @map("created_at")

  user  User  @relation("PositionAccount", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("PositionHandoverActor", fields: [actorId], references: [id])

  @@index([userId, createdAt])
  @@map("position_handover_logs")
}

enum PositionAccountAction {
  /// ส่งมอบให้ผู้ดำรงตำแหน่งคนใหม่ - เปลี่ยนทั้งชื่อและรหัสผ่าน
  HANDOVER
  /// ผู้ดำรงตำแหน่งคนเดิม แต่ตั้งรหัสผ่านใหม่ให้
  PASSWORD_RESET
}

/// Where to deliver a popup notification (Web Push, CLAUDE.md ข้อ 10).
/// One row per browser that allowed notifications; a person may have several.
model PushSubscription {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  /// The browser's address on its push service. One browser has exactly one,
  /// so when someone else signs in there the row moves to them.
  endpoint  String   @unique @db.Text
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
